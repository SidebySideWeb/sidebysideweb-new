---
import PageHero from '../components/v2/PageHero.astro'
import BigCta from '../components/v2/home/BigCta.astro'
import ProcessSteps from '../components/v2/pages/ProcessSteps.astro'
import RulesSection from '../components/v2/pages/RulesSection.astro'
import Base from '../layouts/Base.astro'
import {getProcessPage} from '../lib/v2/cms'
import '../styles/v2-pages.css'

export const prerender = false

const page = await getProcessPage()

if (!page) {
  return new Response('Η σελίδα διαδικασίας δεν έχει περιεχόμενο στο Sanity.', {status: 404})
}

const title = page.seo?.title ?? 'Πώς δουλεύω · Side by Side'
const description =
  page.seo?.description ?? 'Τεχνικός συνεργάτης για ελληνικές επιχειρήσεις.'
---

<Base title={title} description={description}>
  <div data-page="process" class="enter">
    <PageHero hero={page.hero} />
    <ProcessSteps steps={page.steps} />
    <RulesSection section={page.rulesSection} />
    {page.bigCta ? <BigCta cta={page.bigCta} email={page.email} /> : null}
  </div>

  <script src="../scripts/v2/copy.ts"></script>
</Base>
