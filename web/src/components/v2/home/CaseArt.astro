---
/**
 * Generative case art. Shared animation classes (`flt`, `flow`, `scan`, `grow`)
 * live in `v2-sections.css`.
 */
import type {CaseArtKey} from '../../../lib/v2/types'

interface Props {
  artKey?: CaseArtKey | string | null
}

const {artKey} = Astro.props

const V = 'viewBox="0 0 800 440" preserveAspectRatio="xMidYMid slice" aria-hidden="true"'
const MONO = 'JetBrains Mono,monospace'

function kollekta() {
  const cols = [
    ['#13232E', '#1A2F3C', '#13232E'],
    ['#1A2F3C', '#13232E', '#1A2F3C'],
  ]
  let t = ''
  for (let i = 0; i < 3; i++) {
    for (let j = 0; j < 2; j++) {
      t +=
        `<rect class="flt d${(i + j) % 4}" x="${70 + i * 112}" y="${70 + j * 152}" width="96" height="136" rx="6" fill="${cols[j][i]}"/>` +
        `<rect x="${82 + i * 112}" y="${82 + j * 152}" width="72" height="84" rx="3" fill="#F4F6F3" opacity=".9"/>`
    }
  }

  let s = ''
  for (let i = 0; i < 4; i++) {
    for (let j = 0; j < 3; j++) {
      s +=
        `<rect x="${530 + i * 52}" y="${110 + j * 76}" width="40" height="58" rx="4" fill="#13232E"/>` +
        `<rect x="${535 + i * 52}" y="${115 + j * 76}" width="30" height="34" rx="2" fill="#F4F6F3"/>`
    }
  }

  return `<svg ${V}><rect width="800" height="440" fill="#F0B429"/>${t}<path class="flow" d="M420 220 H505" stroke="#13232E" stroke-width="5" fill="none"/><path d="M496 208 l14 12 -14 12" fill="none" stroke="#13232E" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>${s}<text x="530" y="366" font-family="${MONO}" font-size="15" fill="#13232E">πλήρες μέγεθος → web</text></svg>`
}

function site() {
  return `<svg ${V}><rect width="800" height="440" fill="#F4F6F3"/>
      <g class="flt"><rect x="120" y="60" width="560" height="360" rx="10" fill="#fff" stroke="#D7DEDB" stroke-width="2"/>
      <rect x="120" y="60" width="560" height="34" rx="10" fill="#D7DEDB"/><circle cx="142" cy="77" r="5" fill="#9AAAB2"/><circle cx="160" cy="77" r="5" fill="#9AAAB2"/>
      <rect x="150" y="124" width="260" height="30" rx="4" fill="#13232E"/><rect x="150" y="164" width="200" height="30" rx="4" fill="#13232E"/>
      <rect x="150" y="214" width="230" height="10" rx="3" fill="#9AAAB2"/><rect x="150" y="232" width="190" height="10" rx="3" fill="#9AAAB2"/>
      <rect x="150" y="266" width="130" height="40" rx="5" fill="#F0B429"/>
      <rect x="450" y="124" width="200" height="182" rx="6" fill="#13232E"/><rect x="470" y="144" width="30" height="80" rx="3" fill="#F4F6F3"/><rect x="510" y="160" width="30" height="80" rx="3" fill="#F0B429"/>
      <rect x="150" y="336" width="150" height="56" rx="6" fill="#D7DEDB"/><rect x="325" y="336" width="150" height="56" rx="6" fill="#D7DEDB"/><rect x="500" y="336" width="150" height="56" rx="6" fill="#D7DEDB"/></g></svg>`
}

function audit() {
  const labels = ['Ταχύτητα', 'SEO', 'Ασφάλεια', 'Προσβασιμότητα']
  const bars = [0.92, 0.64, 0.81, 0.45]
    .map(
      (v, i) =>
        `<text x="470" y="${150 + i * 62}" font-family="${MONO}" font-size="14" fill="#9AAAB2">${labels[i]}</text>` +
        `<rect x="470" y="${160 + i * 62}" width="240" height="12" rx="3" fill="#1A2F3C"/>` +
        `<rect class="grow" style="animation-delay:${-i * 0.6}s" x="470" y="${160 + i * 62}" width="${240 * v}" height="12" rx="3" fill="${v > 0.6 ? '#F0B429' : '#F4F6F3'}"/>`,
    )
    .join('')

  return `<svg ${V}><rect width="800" height="440" fill="#13232E"/>
      <circle cx="250" cy="230" r="120" fill="none" stroke="#1A2F3C" stroke-width="26"/>
      <circle cx="250" cy="230" r="120" fill="none" stroke="#F0B429" stroke-width="26" stroke-dasharray="${2 * Math.PI * 120 * 0.78} 999" transform="rotate(-90 250 230)" stroke-linecap="round"/>
      <text x="250" y="250" text-anchor="middle" font-family="Commissioner,sans-serif" font-weight="800" font-size="72" fill="#F4F6F3">78</text>
      <text x="250" y="286" text-anchor="middle" font-family="${MONO}" font-size="13" fill="#9AAAB2">/100 · δείγμα</text>${bars}
      <rect class="scan" x="440" y="110" width="300" height="2" fill="#F0B429" opacity=".6"/></svg>`
}

function erp() {
  const erpRows = [0, 1, 2, 3]
    .map(
      (i) =>
        `<rect x="120" y="${195 + i * 24}" width="${150 - i * 20}" height="10" rx="3" fill="#2A3C47"/>`,
    )
    .join('')
  const shopTiles = [0, 1]
    .map((i) => `<rect x="${520 + i * 84}" y="195" width="70" height="80" rx="4" fill="#D7DEDB"/>`)
    .join('')

  return `<svg ${V}><rect width="800" height="440" fill="#0B161D"/>
      <g class="flt"><rect x="90" y="130" width="220" height="180" rx="10" fill="#13232E" stroke="#2A3C47" stroke-width="2"/><text x="120" y="175" font-family="${MONO}" font-size="16" fill="#F0B429">ERP</text>
      ${erpRows}</g>
      <g class="flt d2"><rect x="490" y="130" width="220" height="180" rx="10" fill="#F4F6F3"/><text x="520" y="175" font-family="${MONO}" font-size="16" fill="#13232E">e-shop</text>
      ${shopTiles}</g>
      <path class="flow" d="M310 200 C 400 200, 400 200, 490 200" stroke="#F0B429" stroke-width="5" fill="none"/>
      <path class="flow" d="M490 250 C 400 250, 400 250, 310 250" stroke="#F4F6F3" stroke-width="5" fill="none" style="animation-direction:reverse"/>
      <text x="400" y="380" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9AAAB2">παραγγελίες · αποθέματα · τιμές</text></svg>`
}

function feed() {
  const posts = [0, 1, 2]
    .map(
      (i) =>
        `<g class="flt d${i}">` +
        `<rect x="60" y="${80 + i * 100}" width="210" height="78" rx="10" fill="#13232E" stroke="#2A3C47" stroke-width="2"/>` +
        `<circle cx="92" cy="${112 + i * 100}" r="14" fill="#1A2F3C"/>` +
        `<text x="92" y="${117 + i * 100}" text-anchor="middle" font-family="${MONO}" font-size="16" font-weight="700" fill="#F0B429">X</text>` +
        `<rect x="118" y="${100 + i * 100}" width="130" height="9" rx="2" fill="#F4F6F3" opacity=".85"/>` +
        `<rect x="118" y="${118 + i * 100}" width="100" height="8" rx="2" fill="#52616B"/>` +
        `<rect x="118" y="${134 + i * 100}" width="70" height="8" rx="2" fill="#2A3C47"/>` +
        `</g>`,
    )
    .join('')

  return `<svg ${V}><rect width="800" height="440" fill="#0B161D"/>
      ${posts}
      <path class="flow" d="M270 200 H330" stroke="#F0B429" stroke-width="5" fill="none"/>
      <path d="M322 188 l14 12 -14 12" fill="none" stroke="#F0B429" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <g class="flt d1">
        <rect x="330" y="145" width="140" height="150" rx="12" fill="#F0B429"/>
        <text x="400" y="205" text-anchor="middle" font-family="${MONO}" font-size="22" font-weight="700" fill="#13232E">XML</text>
        <text x="400" y="235" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#13232E">feed</text>
        <rect x="355" y="255" width="90" height="8" rx="2" fill="#13232E" opacity=".35"/>
        <rect x="365" y="272" width="70" height="8" rx="2" fill="#13232E" opacity=".25"/>
      </g>
      <path class="flow" d="M470 200 H530" stroke="#F4F6F3" stroke-width="5" fill="none"/>
      <path d="M522 188 l14 12 -14 12" fill="none" stroke="#F4F6F3" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <g class="flt d2">
        <rect x="530" y="95" width="220" height="250" rx="12" fill="#F4F6F3"/>
        <rect x="530" y="95" width="220" height="28" rx="12" fill="#D7DEDB"/>
        <circle cx="548" cy="109" r="5" fill="#9AAAB2"/><circle cx="566" cy="109" r="5" fill="#9AAAB2"/>
        <rect x="550" y="145" width="180" height="14" rx="3" fill="#13232E"/>
        <rect x="550" y="175" width="140" height="10" rx="2" fill="#9AAAB2"/>
        <rect x="550" y="195" width="160" height="10" rx="2" fill="#9AAAB2"/>
        <rect x="550" y="230" width="180" height="70" rx="6" fill="#13232E"/>
        <rect class="scan" x="550" y="230" width="180" height="2" fill="#F0B429" opacity=".7"/>
        <text x="640" y="275" text-anchor="middle" font-family="${MONO}" font-size="13" fill="#F0B429">live updates</text>
      </g>
      <text x="400" y="400" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9AAAB2">X → XML → site</text></svg>`
}

function b2b() {
  const cards = [0, 1, 2, 3]
    .map(
      (i) =>
        `<g class="flt d${i}"><rect x="${170 + i * 40}" y="${70 + i * 50}" width="420" height="120" rx="10" fill="${i === 3 ? '#F0B429' : '#13232E'}" stroke="#2A3C47"/>` +
        `<rect x="${200 + i * 40}" y="${100 + i * 50}" width="140" height="14" rx="3" fill="${i === 3 ? '#13232E' : '#F4F6F3'}"/>` +
        `<rect x="${200 + i * 40}" y="${126 + i * 50}" width="220" height="10" rx="3" fill="${i === 3 ? '#13232E' : '#52616B'}" opacity=".7"/>` +
        `<text x="${540 + i * 40}" y="${114 + i * 50}" text-anchor="end" font-family="${MONO}" font-size="14" fill="${i === 3 ? '#13232E' : '#F0B429'}">#${1040 + i}</text></g>`,
    )
    .join('')

  return `<svg ${V}><rect width="800" height="440" fill="#1A2F3C"/>${cards}</svg>`
}

/** Fashion brand: lookbook rail → boutique. */
function fashion() {
  const looks = [0, 1, 2, 3]
    .map(
      (i) =>
        `<g class="flt d${i % 4}">` +
        `<rect x="${70 + i * 100}" y="${90 + (i % 2) * 20}" width="84" height="220" rx="8" fill="${i % 2 ? '#1A2F3C' : '#13232E'}"/>` +
        `<rect x="${82 + i * 100}" y="${108 + (i % 2) * 20}" width="60" height="140" rx="4" fill="#F4F6F3" opacity=".92"/>` +
        `<rect x="${90 + i * 100}" y="${260 + (i % 2) * 20}" width="44" height="10" rx="2" fill="#F0B429"/>` +
        `</g>`,
    )
    .join('')

  return `<svg ${V}><rect width="800" height="440" fill="#0B161D"/>
      ${looks}
      <path class="flow" d="M470 200 H540" stroke="#F0B429" stroke-width="5" fill="none"/>
      <path d="M532 188 l14 12 -14 12" fill="none" stroke="#F0B429" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <g class="flt d2">
        <rect x="540" y="110" width="200" height="220" rx="12" fill="#F4F6F3"/>
        <rect x="560" y="140" width="70" height="100" rx="4" fill="#13232E"/>
        <rect x="650" y="140" width="70" height="100" rx="4" fill="#1A2F3C"/>
        <rect x="560" y="260" width="160" height="12" rx="2" fill="#D7DEDB"/>
        <rect x="560" y="284" width="110" height="10" rx="2" fill="#9AAAB2"/>
        <text x="640" y="330" text-anchor="middle" font-family="${MONO}" font-size="13" fill="#13232E">σεζόν · καταστήματα</text>
      </g>
      <text x="400" y="400" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9AAAB2">lookbook → boutique</text></svg>`
}

/** Hospitality: day parts + reservation. */
function hospitality() {
  const moments = [
    {label: 'brunch', x: 80},
    {label: 'φαγητό', x: 280},
    {label: 'cocktails', x: 480},
  ]
    .map(
      (m, i) =>
        `<g class="flt d${i}">` +
        `<rect x="${m.x}" y="100" width="170" height="160" rx="12" fill="${i === 2 ? '#F0B429' : '#13232E'}"/>` +
        `<text x="${m.x + 85}" y="160" text-anchor="middle" font-family="${MONO}" font-size="14" fill="${i === 2 ? '#13232E' : '#F0B429'}">${m.label}</text>` +
        `<rect x="${m.x + 30}" y="185" width="110" height="10" rx="2" fill="${i === 2 ? '#13232E' : '#52616B'}" opacity=".7"/>` +
        `<rect x="${m.x + 40}" y="210" width="90" height="10" rx="2" fill="${i === 2 ? '#13232E' : '#2A3C47'}" opacity=".7"/>` +
        `</g>`,
    )
    .join('')

  return `<svg ${V}><rect width="800" height="440" fill="#1A2F3C"/>
      ${moments}
      <g class="flt d1">
        <rect x="280" y="300" width="240" height="56" rx="28" fill="#F4F6F3"/>
        <text x="400" y="335" text-anchor="middle" font-family="${MONO}" font-size="15" fill="#13232E">κλείσε τραπέζι</text>
      </g>
      <text x="400" y="400" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9AAAB2">μενού · δίγλωσσο · κρατήσεις</text></svg>`
}

/** Construction: aluminum frames / openings. */
function construction() {
  const frames = [0, 1, 2]
    .map(
      (i) =>
        `<g class="flt d${i}">` +
        `<rect x="${90 + i * 140}" y="${80 + i * 18}" width="120" height="200" rx="4" fill="none" stroke="#F0B429" stroke-width="8"/>` +
        `<rect x="${102 + i * 140}" y="${92 + i * 18}" width="96" height="176" rx="2" fill="#13232E"/>` +
        `<line x1="${150 + i * 140}" y1="${92 + i * 18}" x2="${150 + i * 140}" y2="${268 + i * 18}" stroke="#2A3C47" stroke-width="3"/>` +
        `<line x1="${102 + i * 140}" y1="${180 + i * 18}" x2="${198 + i * 140}" y2="${180 + i * 18}" stroke="#2A3C47" stroke-width="3"/>` +
        `</g>`,
    )
    .join('')

  return `<svg ${V}><rect width="800" height="440" fill="#0B161D"/>
      ${frames}
      <g class="flt d2">
        <rect x="520" y="120" width="220" height="180" rx="12" fill="#F4F6F3"/>
        <text x="630" y="175" text-anchor="middle" font-family="${MONO}" font-size="15" fill="#13232E">500+ έργα</text>
        <rect x="555" y="200" width="150" height="12" rx="2" fill="#D7DEDB"/>
        <rect x="575" y="228" width="110" height="12" rx="2" fill="#9AAAB2"/>
        <rect x="560" y="256" width="140" height="28" rx="6" fill="#F0B429"/>
      </g>
      <text x="400" y="400" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9AAAB2">κουφώματα · εξοικονομώ · προσφορές</text></svg>`
}

/** Media portal: stacked articles + magazine. */
function media() {
  const rows = [0, 1, 2, 3]
    .map(
      (i) =>
        `<g class="flt d${i % 4}">` +
        `<rect x="70" y="${70 + i * 70}" width="420" height="58" rx="8" fill="${i === 0 ? '#F0B429' : '#13232E'}"/>` +
        `<rect x="90" y="${88 + i * 70}" width="${i === 0 ? 200 : 160}" height="10" rx="2" fill="${i === 0 ? '#13232E' : '#F4F6F3'}" opacity=".9"/>` +
        `<rect x="90" y="${108 + i * 70}" width="280" height="8" rx="2" fill="${i === 0 ? '#13232E' : '#52616B'}" opacity=".55"/>` +
        `</g>`,
    )
    .join('')

  return `<svg ${V}><rect width="800" height="440" fill="#1A2F3C"/>
      ${rows}
      <g class="flt d2">
        <rect x="540" y="90" width="190" height="250" rx="10" fill="#F4F6F3"/>
        <rect x="560" y="120" width="150" height="20" rx="3" fill="#13232E"/>
        <rect x="560" y="160" width="150" height="100" rx="4" fill="#D7DEDB"/>
        <rect class="scan" x="560" y="160" width="150" height="2" fill="#F0B429" opacity=".8"/>
        <text x="635" y="300" text-anchor="middle" font-family="${MONO}" font-size="13" fill="#13232E">περιοδικό</text>
        <text x="635" y="322" text-anchor="middle" font-family="${MONO}" font-size="12" fill="#9AAAB2">newsletter</text>
      </g>
      <text x="400" y="400" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9AAAB2">ρεπορτάζ · tags · διαφήμιση</text></svg>`
}

/** Sports club: age bands + medal. */
function sports() {
  const bands = [0, 1, 2, 3]
    .map(
      (i) =>
        `<g class="flt d${i}">` +
        `<circle cx="${140 + i * 90}" cy="200" r="${48 - i * 4}" fill="none" stroke="${i === 3 ? '#F0B429' : '#52616B'}" stroke-width="6"/>` +
        `<text x="${140 + i * 90}" y="206" text-anchor="middle" font-family="${MONO}" font-size="12" fill="${i === 3 ? '#F0B429' : '#9AAAB2'}">${['GfA', '6–Teen', 'Adults', 'Kids'][i]}</text>` +
        `</g>`,
    )
    .join('')

  return `<svg ${V}><rect width="800" height="440" fill="#0B161D"/>
      ${bands}
      <g class="flt d1">
        <path d="M620 120 l28 56 62 9 -45 44 11 62 -56 -30 -56 30 11 -62 -45 -44 62 -9z" fill="#F0B429"/>
        <text x="648" y="210" text-anchor="middle" font-family="${MONO}" font-size="13" fill="#13232E">200+</text>
      </g>
      <text x="400" y="360" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9AAAB2">τμήματα · διακρίσεις · εγγραφές</text>
      <text x="400" y="400" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#52616B">σύλλογος → γονείς</text></svg>`
}

/** Travel: route + booking card. */
function travel() {
  return `<svg ${V}><rect width="800" height="440" fill="#13232E"/>
      <g class="flt">
        <circle cx="140" cy="220" r="18" fill="#F0B429"/>
        <circle cx="360" cy="140" r="14" fill="#F4F6F3"/>
        <circle cx="320" cy="300" r="12" fill="#F4F6F3" opacity=".7"/>
        <circle cx="480" cy="240" r="16" fill="#F0B429"/>
        <path class="flow" d="M158 214 C 240 180, 280 160, 346 146" stroke="#F0B429" stroke-width="4" fill="none"/>
        <path class="flow" d="M370 155 C 400 200, 420 230, 464 236" stroke="#9AAAB2" stroke-width="4" fill="none"/>
        <path class="flow" d="M150 235 C 220 280, 260 300, 310 300" stroke="#52616B" stroke-width="3" fill="none"/>
      </g>
      <g class="flt d2">
        <rect x="540" y="100" width="210" height="240" rx="14" fill="#F4F6F3"/>
        <rect x="560" y="130" width="170" height="14" rx="3" fill="#13232E"/>
        <rect x="560" y="160" width="120" height="10" rx="2" fill="#9AAAB2"/>
        <rect x="560" y="200" width="170" height="70" rx="8" fill="#D7DEDB"/>
        <rect x="560" y="290" width="170" height="28" rx="6" fill="#F0B429"/>
        <text x="645" y="309" text-anchor="middle" font-family="${MONO}" font-size="12" fill="#13232E">κράτηση</text>
      </g>
      <text x="400" y="400" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9AAAB2">εκδρομές · VIP · διαθεσιμότητα</text></svg>`
}

const ART: Record<string, () => string> = {
  kollekta,
  site,
  audit,
  erp,
  feed,
  b2b,
  fashion,
  hospitality,
  construction,
  media,
  sports,
  travel,
}
const html = (ART[artKey ?? ''] ?? site)()
---

<Fragment set:html={html} />
