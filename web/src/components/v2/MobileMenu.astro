---
import {isActivePath, resolveHref} from '../../lib/v2/links'
import type {LinkItem} from '../../lib/v2/types'

interface Props {
  nav?: LinkItem[] | null
}

const FALLBACK_NAV: LinkItem[] = [
  {href: '/ypiresies', label: 'Υπηρεσίες'},
  {href: '/pos-doulevo', label: 'Πώς δουλεύω'},
  {href: '/erga', label: 'Έργα'},
  {href: '/poios-eimai', label: 'Ποιος είμαι'},
  {href: '/epikoinonia', label: 'Επικοινωνία'},
]

const {nav = FALLBACK_NAV} = Astro.props
const path = Astro.url.pathname

const links = [
  {href: '/', label: 'Αρχική', n: '00'},
  ...(nav?.length ? nav : FALLBACK_NAV).map((item, index) => ({
    href: resolveHref(item.href),
    label: item.label,
    n: String(index + 1).padStart(2, '0'),
  })),
]
---

<div class="mobile" id="mobile">
  {
    links.map((link) => (
      <a href={link.href} aria-current={isActivePath(path, link.href) ? 'page' : undefined}>
        <small>{link.n}</small>
        {link.label}
      </a>
    ))
  }
</div>
