---
/** "What happens next" plus the copyable email, beside the contact form. */
import CopyBox from '../CopyBox.astro'
import type {ContactPage} from '../../../lib/v2/types'

interface Props {
  page: ContactPage
}

const {page} = Astro.props
const steps = page.nextSteps ?? []
---

<aside class="side-card">
  {page.nextStepsTitle ? <h3>{page.nextStepsTitle}</h3> : null}
  {
    steps.length ? (
      <ol>
        {steps.map((step) => (
          <li>
            <div>
              <b>{step.title}</b>
              {step.text}
            </div>
          </li>
        ))}
      </ol>
    ) : null
  }
  {
    page.email ? (
      <div style="border-top:1px solid var(--line);padding-top:20px;display:grid;gap:10px">
        {page.directLabel ? <span class="eyebrow">{page.directLabel}</span> : null}
        <CopyBox value={page.email} />
      </div>
    ) : null
  }
</aside>
