---
/**
 * Contact form, markup from the prototype. With JS, `contact.ts` validates and
 * posts JSON, then reveals the inline `.sent` panel. Without JS the form posts
 * to `/api/contact` and redirects back with `?sent=1` or `?error=…`.
 */
import {getRecaptchaSiteKey} from '../../../lib/recaptcha'
import type {ContactPage} from '../../../lib/v2/types'

interface Props {
  page: ContactPage
  /** Server-rendered thank-you / error state for the no-JS path. */
  sent?: boolean
  error?: string
}

const {page, sent = false, error} = Astro.props
const form = page.form ?? {}
const needs = page.needOptions ?? []
const budgets = page.budgetOptions ?? []
const siteKey = getRecaptchaSiteKey()

const ERROR_MESSAGE = 'Κάτι πήγε στραβά. Δοκίμασε ξανά ή στείλε μου email.'
const SUCCESS_MESSAGE = page.successMessage ?? 'Το μήνυμα στάλθηκε.'
const showSent = sent
const showError = Boolean(error) && !sent
const panelOpen = showSent || showError
---

<form
  class="form"
  id="form"
  method="post"
  action="/api/contact"
  novalidate
  data-recaptcha-key={siteKey}
  data-error={ERROR_MESSAGE}
  data-success={SUCCESS_MESSAGE}
>
  {/* Honeypot: invisible to people, irresistible to bots. */}
  <div class="hp" aria-hidden="true">
    <label for="f-website">Website</label>
    <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="formStartedAt" value={String(Date.now())} data-form-started />
  <input type="hidden" name="privacyAccepted" value="1" />

  <div class="f2">
    <div class="field">
      <label for="f-name">{form.nameLabel ?? 'Όνομα'}</label>
      <input
        id="f-name"
        name="name"
        autocomplete="name"
        placeholder={form.namePlaceholder}
        required
      />
    </div>
    <div class="field">
      <label for="f-mail">{form.emailLabel ?? 'Email'}</label>
      <input
        id="f-mail"
        name="email"
        type="email"
        autocomplete="email"
        placeholder={form.emailPlaceholder}
        required
      />
    </div>
  </div>

  <div class="field">
    <label for="f-co">{form.companyLabel ?? 'Εταιρεία'}</label>
    <input id="f-co" name="company" autocomplete="organization" placeholder={form.companyPlaceholder} />
  </div>

  {
    needs.length ? (
      <fieldset class="field">
        <legend>{form.needLegend ?? 'Τι χρειάζεσαι'}</legend>
        <div class="opts" style="margin-top:10px">
          {needs.map((option) => (
            <Fragment>
              <input type="checkbox" id={`need-${option.value}`} name="need" value={option.label} />
              <label for={`need-${option.value}`}>{option.label}</label>
            </Fragment>
          ))}
        </div>
      </fieldset>
    ) : null
  }

  {
    budgets.length ? (
      <fieldset class="field">
        <legend>{form.budgetLegend ?? 'Κλίμακα έργου'}</legend>
        <div class="opts" style="margin-top:10px">
          {budgets.map((option) => (
            <Fragment>
              <input type="radio" id={`budget-${option.value}`} name="budget" value={option.label} />
              <label for={`budget-${option.value}`}>{option.label}</label>
            </Fragment>
          ))}
        </div>
      </fieldset>
    ) : null
  }

  <div class="field">
    <label for="f-msg">{form.messageLabel ?? 'Τι δεν δουλεύει σήμερα;'}</label>
    <textarea id="f-msg" name="msg" placeholder={form.messagePlaceholder} required></textarea>
  </div>

  <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
    <button class="btn btn-m mag" type="submit">
      {form.submitLabel ?? 'Στείλε μήνυμα'}
      <span class="bars"><b></b><b></b></span>
    </button>
    {page.privacyNote ? <span style="font-size:13.5px;color:var(--muted)">{page.privacyNote}</span> : null}
  </div>

  <div
    class:list={['sent', {error: showError, 'is-visible': panelOpen}]}
    id="sent"
    role="status"
    aria-live="polite"
    hidden={!panelOpen}
  >
    <b data-sent-title>{showError ? ERROR_MESSAGE : SUCCESS_MESSAGE}</b>
    <span data-sent-note style="color:var(--muted);font-size:15px"></span>
  </div>
</form>
