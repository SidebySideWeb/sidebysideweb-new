---
/** Six skill pillars with proof lines. */
import Eyebrow from '../Eyebrow.astro'
import Lines from '../Lines.astro'
import type {AboutRolesSection} from '../../../lib/v2/types'

interface Props {
  section?: AboutRolesSection
}

const {section} = Astro.props
const roles = section?.roles ?? []
---

{
  roles.length ? (
    <section class="sec">
      <div class="wrap">
        <div class="sec-hd">
          <div>
            {section?.eyebrow ? <Eyebrow>{section.eyebrow}</Eyebrow> : null}
            {section?.heading ? (
              <h2 class="rv">
                <Lines text={section.heading} />
              </h2>
            ) : null}
          </div>
          {section?.intro ? <p class="rv">{section.intro}</p> : null}
        </div>
        <div class="pgrid">
          {roles.map((role, index) => (
            <article class="pcard rv">
              <span class="pi">{role.indexLabel ?? String(index + 1).padStart(2, '0')}</span>
              <h3>{role.title}</h3>
              {role.text ? <p>{role.text}</p> : null}
              {role.proof ? (
                <div class="proof">
                  <i></i>
                  <span>{role.proof}</span>
                </div>
              ) : null}
            </article>
          ))}
        </div>
      </div>
    </section>
  ) : null
}
