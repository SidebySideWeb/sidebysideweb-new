          {products.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Επαφή</h4>
        <ul>
          <li>dgeronikolos@<br />sidebysideweb.gr</li>
          <li>
            <a href="https://www.linkedin.com/" target="_blank" rel="noopener"
              >LinkedIn <span class="ph">[link]</span></a
            >
          </li>
