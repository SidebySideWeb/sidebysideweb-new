---
interface Props {
  href: string
  variant?: 'm' | 'g' | 'p' | 'i'
  size?: 'sm'
  class?: string
  magnetic?: boolean
  bars?: boolean
  /** Smooth-scroll target id (audit CTA → form). */
  dataJump?: string
}

const {
  href,
  variant = 'm',
  size,
  class: className,
  magnetic = false,
  bars = true,
  dataJump,
} = Astro.props
---

<a
  class:list={['btn', `btn-${variant}`, size === 'sm' && 'btn-sm', magnetic && 'mag', className]}
  href={href}
  data-jump={dataJump}
>
  <slot />
  {
    bars ? (
      <span class="bars">
        <b></b>
        <b></b>
      </span>
    ) : null
  }
</a>
