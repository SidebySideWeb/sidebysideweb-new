---
/**
 * Inline SVG icons from the audit prototype (fallback when report.ts is unavailable).
 */
interface Props {
  name?: string
  class?: string
}

const {name = 'i-qa', class: className = 'ico'} = Astro.props
---

{
  name === 'i-a11y' ? (
    <svg class={className} viewBox="0 0 32 32" aria-hidden="true">
      <circle cx="16" cy="7" r="3.2"></circle>
      <path d="M6 12.5h20M16 12.5v7M16 19.5l-5 8M16 19.5l5 8"></path>
    </svg>
  ) : name === 'i-perf' ? (
    <svg class={className} viewBox="0 0 32 32" aria-hidden="true">
      <path d="M5 23a11 11 0 1 1 22 0"></path>
      <path d="M16 23l6-8"></path>
      <circle cx="16" cy="23" r="1.6"></circle>
    </svg>
  ) : name === 'i-geo' ? (
    <svg class={className} viewBox="0 0 32 32" aria-hidden="true">
      <path d="M16 4l2.6 7.4L26 14l-7.4 2.6L16 24l-2.6-7.4L6 14l7.4-2.6z"></path>
      <path d="M25 22l1 3 3 1-3 1-1 3-1-3-3-1 3-1z"></path>
    </svg>
  ) : name === 'i-sec' ? (
    <svg class={className} viewBox="0 0 32 32" aria-hidden="true">
      <path d="M16 4l10 4v7c0 6.5-4.3 11.2-10 13-5.7-1.8-10-6.5-10-13V8z"></path>
      <path d="M11.5 16l3 3 6-6.5"></path>
    </svg>
  ) : (
    <svg class={className} viewBox="0 0 32 32" aria-hidden="true">
      <rect x="6" y="5" width="20" height="23" rx="2"></rect>
      <path d="M11 12l2 2 4-4M11 20l2 2 4-4M20 13h2M20 21h2"></path>
    </svg>
  )
}
