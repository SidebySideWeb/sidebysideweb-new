---
import {ClientRouter} from 'astro:transitions'
import CookieConsent from '../components/CookieConsent.astro'
import GtmBody from '../components/GtmBody.astro'
import GtmHead from '../components/GtmHead.astro'
import Footer from '../components/v2/Footer.astro'
import Header from '../components/v2/Header.astro'
import MobileMenu from '../components/v2/MobileMenu.astro'
import '../styles/v2-global.css'

interface Props {
  title?: string
  description?: string
}

const {title = 'Side by Side', description = 'Τεχνικός συνεργάτης για ελληνικές επιχειρήσεις.'} =
  Astro.props
const gtmId = (import.meta.env.PUBLIC_GTM_ID ?? 'GTM-T4W88CDJ').trim()
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <CookieConsent />
    {gtmId ? <GtmHead gtmId={gtmId} /> : null}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <ClientRouter />
  </head>
  <body>
    {gtmId ? <GtmBody gtmId={gtmId} /> : null}
    <div id="progress"></div>
    <div class="cur" aria-hidden="true"></div>
    <div class="cur-ring" aria-hidden="true"></div>
    <Header />
    <MobileMenu />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/v2/header.ts"></script>
    <script src="../scripts/v2/cursor.ts"></script>
    <script src="../scripts/v2/magnetic.ts"></script>
  </body>
</html>
